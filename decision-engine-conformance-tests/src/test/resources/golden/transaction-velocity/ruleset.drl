package golden.velocity;

global java.util.Map result;

rule "velocity-threshold-reached"
when
  Number(intValue >= 3) from accumulate(Map(), count(1))
then
  result.put("outcome", "velocity_alert");
  result.put("dataset", "transaction-velocity");
end
