package golden.payments;

global java.util.Map result;

rule "high-risk-payment"
when
  Map(this["risk"] == "high")
then
  result.put("outcome", "manual_review");
  result.put("dataset", "payments-risk");
end

rule "low-risk-payment"
when
  Map(this["risk"] == "low")
then
  result.put("outcome", "approved");
  result.put("dataset", "payments-risk");
end
