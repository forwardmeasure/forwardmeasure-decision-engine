<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.decisionengine</groupId>
        <artifactId>forwardmeasure-decision-engine-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.decisionengine</groupId>
    <artifactId>decision-engine-grpc</artifactId>
    <packaging>jar</packaging>

    <name>ForwardMeasure Decision Engine :: gRPC</name>
    <description>Framework-neutral EvaluationServiceImpl / ManagementServiceImpl (IMPLEMENTATION-SPEC.md Section 8.1) - hosted identically by all three framework bindings. No @GrpcService, no Spring @Bean, no Micronaut @Singleton anywhere in this module - those belong exclusively in decision-engine-framework-bindings/*. Protocol-specific by nature (implements the grpc-generated *ImplBase classes) - a future Thrift interface would need its own analogous module alongside this one, sharing decision-engine-core/decision-engine-domain, not a change to this module.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>decision-engine-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>decision-engine-core</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>decision-engine-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>decision-engine-api-language-bindings-java-grpc</artifactId>
        </dependency>
        <dependency>
            <!-- TenantId/TenantSchema/TenantScope for the tenant-resolution interceptor package -
                 previously only transitive via decision-engine-jpa. -->
            <groupId>com.forwardmeasure.jpa</groupId>
            <artifactId>forwardmeasure-jpa-tenancy</artifactId>
        </dependency>
        <dependency>
            <!-- VerifiedJwtTenantResolver's own claims->tenant extraction - KeycloakOrganizationClaims
                 is framework-neutral (takes a plain parsed claims Map, not a framework-specific
                 Authentication/JsonWebToken type), matching this module's own no-framework-deps rule. -->
            <groupId>com.forwardmeasure.authzen</groupId>
            <artifactId>forwardmeasure-authzen-api</artifactId>
        </dependency>
        <dependency>
            <!-- VerifiedJwtTenantResolver's own raw JWT signature verification (JWKS fetch + RS256
                 check) - gRPC has no built-in JWT-verifying filter chain the way JAX-RS/Micronaut
                 Security/Spring Security do on the HTTP side (confirmed: nothing framework-agnostic
                 for this exists anywhere in forwardmeasure-authzen), so this module does it directly.
                 Not managed by any BOM in this workspace as of this addition - pinned to the version
                 already resolvable in this workspace's own .m2 (pulled transitively by Quarkus
                 OIDC/Spring Security elsewhere), the same standard library Spring Security's own
                 NimbusJwtDecoder uses internally. -->
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>10.9.1</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- VerifiedJwtTenantResolverTest's real Keycloak fixture: real Organizations-shaped
                 JWTs, the same real Admin REST provisioning sequence fowf/fei's own tests already
                 rely on, generalized so this module doesn't need its own product-specific copy. -->
            <groupId>com.forwardmeasure.authzen</groupId>
            <artifactId>forwardmeasure-authzen-testkit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
