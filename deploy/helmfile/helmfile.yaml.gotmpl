#
# This product Helmfile consumes the canonical chart source from the sibling helm-charts checkout
# during local development. Published platform deployments consume the versioned chart artifact
# from the ForwardMeasure chart repository.
#
# One release group, inlined directly here rather than split into a separate helmfiles/*.yaml.gotmpl
# dispatched from this file - forwardmeasure-platform/deploy's own multi-stage split (00-foundation,
# 10-platform-configuration, 20-identity, ...) exists because that repository orchestrates eight-plus
# unrelated pieces of shared platform infrastructure; this repository deploys exactly one thing.
# Introduce that extra layer of indirection only if this repository's own deployment genuinely grows
# past one logical stage - do not add it preemptively.
helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 1800
  atomic: true
  createNamespace: false

environments:
  # Every environment ends with forwardmeasure-platform's shared layer (the single source of truth
  # for cross-repository values - see its deploy/helmfile/shared/common.yaml.gotmpl), loaded by
  # relative path from the sibling checkout.
  base:
    values:
      - environments/chart-versions.yaml
      - environments/base.yaml.gotmpl
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/common.yaml.gotmpl
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/chart-versions.yaml
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/image-versions.yaml
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/clusters/base.yaml.gotmpl
  # Real target cluster this repo's own release deploys into, alongside forwardmeasure-openworkflow/
  # forwardmeasure-data-streaming/forwardmeasure-entity-intelligence - see
  # environments/gcp-platform-cluster.yaml.gotmpl's own header for why this entry exists (fixes a
  # real install-platform.sh abort, 2026-09-29). base.yaml.gotmpl first, then the prod overlay on
  # top, same layering convention every other product repo's own helmfile.yaml.gotmpl already uses.
  gcp-openworkflow-prod:
    values:
      - environments/chart-versions.yaml
      - environments/base.yaml.gotmpl
      - environments/gcp-platform-cluster.yaml.gotmpl
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/common.yaml.gotmpl
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/chart-versions.yaml
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/image-versions.yaml
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/clusters/gcp-openworkflow-prod.yaml.gotmpl
  # Worked example of a second platform cluster - same profile, different shared cluster file.
  gcp-greenfield-example:
    values:
      - environments/chart-versions.yaml
      - environments/base.yaml.gotmpl
      - environments/gcp-platform-cluster.yaml.gotmpl
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/common.yaml.gotmpl
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/chart-versions.yaml
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/image-versions.yaml
      - ../../../forwardmeasure-platform/deploy/helmfile/shared/clusters/gcp-greenfield-example.yaml.gotmpl

---

{{- $valkeyMode := .Values.factWindow.valkey.mode }}

repositories:
  - name: valkey
    url: https://valkey.io/valkey-helm

releases:
  # See IMPLEMENTATION-SPEC.md Section 9.2 for the full rationale - this conditional-release
  # mechanism (installed: conditional true/false) is the SAME pattern already
  # proven in forwardmeasure-platform/deploy/helmfile/helmfiles/10-platform-configuration.yaml.gotmpl
  # for platform-secrets/platform-routing. Deliberately NOT using Helm's native subchart
  # `condition:` dependency mechanism in Chart.yaml - nothing in this ecosystem uses that mechanism
  # yet, and reusing an already-proven pattern beats introducing a second way to do the same thing.
  - name: decision-engine-valkey
    namespace: {{ .Values.platform.namespaces.decisionEngine }}
    chart: valkey/valkey
    version: {{ .Values.chartVersions.valkey | quote }}
    installed: {{ if eq $valkeyMode "embedded" }}true{{ else }}false{{ end }}
    labels: {component: fact-window}

  - name: decision-engine
    namespace: {{ .Values.platform.namespaces.decisionEngine }}
    # Local workspace path; forwardmeasure-platform uses the published chart artifact instead.
    chart: ../../../helm-charts/charts/decision-engine-helm-chart/helm-chart-sources
    version: {{ .Values.chartVersions.decisionEngine | quote }}
    # Defaults true (base/local/dev - always deployable there), overridden false by
    # gcp-platform-cluster.yaml.gotmpl until its own real database/credentials/Valkey
    # prerequisites exist for real - see that file's own header comment. Without this gate, that
    # environment's own real-but-not-yet-functional values would install a non-functional pod
    # instead of a clean no-op.
    installed: {{ dig "decisionEngine" "enabled" true .Values }}
    labels: {component: server}
    needs:
      {{- if eq $valkeyMode "embedded" }}
      - {{ .Values.platform.namespaces.decisionEngine }}/decision-engine-valkey
      {{- end }}
    values:
      - releases/decision-engine/base.yaml.gotmpl
