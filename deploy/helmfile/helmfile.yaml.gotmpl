#
# This product Helmfile consumes the canonical chart source from the sibling helm-charts checkout
# during local development. Published platform deployments consume the versioned chart artifact
# from the ForwardMeasure chart repository.
#
# One release group, inlined directly here rather than split into a separate helmfiles/*.yaml.gotmpl
# dispatched from this file - forwardmeasure-platform/deploy's own multi-stage split (00-foundation,
# 10-platform-configuration, 20-identity, ...) exists because that repository orchestrates eight-plus
# unrelated pieces of shared platform infrastructure; this repository deploys exactly one thing.
# Introduce that extra layer of indirection only if this repository's own deployment genuinely grows
# past one logical stage - do not add it preemptively.
helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 1800
  atomic: true
  createNamespace: false

environments:
  base:
    values:
      - environments/base.yaml.gotmpl

---

{{- $valkeyMode := .Values.factWindow.valkey.mode }}

repositories:
  - name: valkey
    url: https://valkey.io/valkey-helm

releases:
  # See IMPLEMENTATION-SPEC.md Section 9.2 for the full rationale - this conditional-release
  # mechanism (installed: conditional true/false) is the SAME pattern already
  # proven in forwardmeasure-platform/deploy/helmfile/helmfiles/10-platform-configuration.yaml.gotmpl
  # for platform-secrets/platform-routing. Deliberately NOT using Helm's native subchart
  # `condition:` dependency mechanism in Chart.yaml - nothing in this ecosystem uses that mechanism
  # yet, and reusing an already-proven pattern beats introducing a second way to do the same thing.
  - name: decision-engine-valkey
    namespace: {{ .Values.namespaces.decisionEngine }}
    chart: valkey/valkey
    version: {{ .Values.chartVersions.valkey | quote }}
    installed: {{ if eq $valkeyMode "embedded" }}true{{ else }}false{{ end }}
    labels: {component: fact-window}

  - name: decision-engine
    namespace: {{ .Values.namespaces.decisionEngine }}
    # Local workspace path; forwardmeasure-platform uses the published chart artifact instead.
    chart: ../../../helm-charts/charts/decision-engine-helm-chart/helm-chart-sources
    version: {{ .Values.chartVersions.decisionEngine | quote }}
    labels: {component: server}
    needs:
      {{- if eq $valkeyMode "embedded" }}
      - {{ .Values.namespaces.decisionEngine }}/decision-engine-valkey
      {{- end }}
    values:
      - releases/decision-engine/base.yaml.gotmpl
