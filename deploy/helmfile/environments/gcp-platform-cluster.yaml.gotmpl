# Profile for decision-engine on a GCP cluster running the shared
# forwardmeasure-platform, used by the gcp-openworkflow-prod and gcp-greenfield-example
# environments (was gcp-openworkflow-prod.yaml.gotmpl).
# Nothing here is specific to one cluster: cluster facts (domain, tenants, endpoints, GCP project,
# Cloud SQL instance) come from that environment's forwardmeasure-platform shared cluster file
# (shared/clusters/<env>.yaml.gotmpl), loaded after this one.

# This repository owns the decision-engine release (forwardmeasure-platform no longer carries its own
# copy of it). Cluster facts and cross-repository values come from forwardmeasure-platform's shared
# layer (shared/clusters/<env>.yaml.gotmpl, shared/common.yaml.gotmpl).

# Database: no database of decision-engine's own - rulesets live in each tenant's database
# (forwardmeasure_<alias>, schema decision_intelligence), provisioned by forwardmeasure-openworkflow's
# decision-engine-migrations Job. The server connects to the platform control-plane database
# (tenant_registry) as the decision_engine runtime role, through its Cloud SQL Auth Proxy sidecar.
# Everything it needs is supplied from outside this file:
#   - URL: shared platform.databases.controlPlane (releases/decision-engine/base.yaml.gotmpl)
#   - credentials + Cloud SQL instance: Secret platform.secrets.decisionEngineDatabase, delivered by
#     forwardmeasure-platform's platform-secrets
#   - Workload Identity GSA (roles/cloudsql.client): shared cluster file
#     cloud.gcp.decisionEngine.serviceAccount (created by openworkflow-k8s-setup's Terraform on
#     gcp-openworkflow-prod, k8s-infrastructure/opentofu/gcp on a new cluster)
cloudSqlProxy:
  enabled: true

# Fact window: the platform's shared, cluster-wide Valkey (shared platform.endpoints.valkey.host),
# not this repo's own decision-engine-valkey release; its password arrives as Secret
# platform.secrets.decisionEngineValkey, delivered by platform-secrets.
factWindow:
  valkey:
    mode: external
    external:
      port: 6379

# Consumed by helmfile.yaml.gotmpl's `installed:` gate on the decision-engine release. On since
# 2026-09-29, once the prerequisites above were all provided by config. They still have to exist
# live before the release can start - see docs/handover-2026-09-29-deployment-readiness.md, §4.
decisionEngine:
  enabled: true
