#
# Base environment values - see IMPLEMENTATION-SPEC.md Section 9.2. This repo's own helmfile is
# scoped to one project, not a whole platform - one stage, not eight (contrast with
# forwardmeasure-platform/deploy/helmfile's own environments/base.yaml.gotmpl).
# The namespace (decision-engine), the platform's shared Valkey host and the image-pull Secret come
# from forwardmeasure-platform's shared layer (.Values.platform.*), loaded last by helmfile.yaml.gotmpl.

# chartVersions moved to environments/chart-versions.yaml (2026-09-29).

imageVersions:
  decisionEngine:
    # One image per framework binding; the release runs forwardmeasure-platform's
    # platform.framework. Tag 1.1.0 (was 0.1.0, which was never pushed) matches the repo's own
    # version. A digest is the registry's own for that tag (quarkus's as of 2026-09-29) - setting one
    # opts it into forwardmeasure-platform's sync-image-digests.sh, which re-resolves it on every
    # install-platform.sh run; an empty one (not yet pushed) is never touched and falls back to the tag.
    repositories:
      quarkus: docker.io/forwardmeasure/decision-engine-quarkus
      spring: docker.io/forwardmeasure/decision-engine-spring
      micronaut: docker.io/forwardmeasure/decision-engine-micronaut
    tag: "1.1.0"
    digests:
      quarkus: "sha256:0c7028ebb488e3369b011261c30b1159a065011bc7d2da4b8731cad66217ab2c"
      spring: ""
      micronaut: ""
    pullPolicy: IfNotPresent

# ---------------------------------------------------------------------------
# The Valkey embedded-vs-external toggle (IMPLEMENTATION-SPEC.md Section 9.1/9.2). "embedded" or
# "external", not a boolean - a third mode (e.g. "disabled", for a deployment that only ever runs
# STATELESS rulesets) can be added later without a breaking schema change.
# ---------------------------------------------------------------------------
factWindow:
  valkey:
    mode: embedded
    external:
      host: ""
      port: 6379
      credentialsSecret: ""

# database.url and database.credentialsSecret default to the shared layer (the control-plane
# database and platform.secrets.decisionEngineDatabase) - see releases/decision-engine/base.yaml.gotmpl.

# Off outside a real GCP cluster - see gcp-platform-cluster.yaml.gotmpl.
cloudSqlProxy:
  enabled: false
