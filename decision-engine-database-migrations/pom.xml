<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.decisionengine</groupId>
        <artifactId>forwardmeasure-decision-engine-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.decisionengine</groupId>
    <artifactId>decision-engine-database-migrations</artifactId>
    <packaging>jar</packaging>

    <name>ForwardMeasure Decision Engine :: Database Migrations</name>
    <description>Liquibase changelog for ruleset DEFINITIONS only (IMPLEMENTATION-SPEC.md Section 7.3, being revised alongside this change). Database-per-tenant, schema-per-domain (decision_intelligence) - real provisioning goes through openworkflow-migrations' own OpenWorkflowTenantMigrator, reused as a library the same way forwardmeasure-entity-intelligence's own migration Job does (see RulesetMigrationsMain in decision-engine-deployments/database-migration-service), not a second, parallel tenant-provisioning implementation. This module owns migration content only, per forwardmeasure-database-migrations' own stated design split.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>decision-engine-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.jpa</groupId>
            <artifactId>forwardmeasure-jpa-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.testcontainers</groupId>
            <artifactId>forwardmeasure-testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.jpa</groupId>
            <artifactId>forwardmeasure-jpa-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- DecisionEngineTenantMigrationTest reuses OpenWorkflowTenantMigrator directly against
                 a real testcontainer - same real provisioning path RulesetMigrationsMain drives in
                 production, not a hand-rolled stand-in. Test-scope only here: this module's own main
                 sources never construct it themselves (only the deployment module's Main does). -->
            <groupId>com.forwardmeasure.openworkflow</groupId>
            <artifactId>openworkflow-migrations</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.cassandra</groupId>
                    <artifactId>java-driver-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.httpcomponents.client5</groupId>
                    <artifactId>httpclient5</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
