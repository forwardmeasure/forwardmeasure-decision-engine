<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.decisionengine</groupId>
        <artifactId>forwardmeasure-decision-engine-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.decisionengine</groupId>
    <artifactId>decision-engine-database-migrations</artifactId>
    <packaging>jar</packaging>

    <name>Decision Engine :: Database Migrations</name>
    <description>Liquibase changelog + RulesetSchemaMigrator for ruleset DEFINITIONS only (IMPLEMENTATION-SPEC.md Section 7.3) - a direct port of forwardmeasure-agent-os's own AgentOsTenantMigrator, itself ported from openworkflow-migrations. Single-tenant (one fixed schema, not schema-per-tenant - Section 13 item 3), same two-credential model (this module's own migrator connects as the administrator credential; decision-engine-jpa's runtime services never do).</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>decision-engine-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.jpa</groupId>
            <artifactId>forwardmeasure-jpa-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.testcontainers</groupId>
            <artifactId>forwardmeasure-testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
