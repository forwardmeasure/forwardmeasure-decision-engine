<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="decision-engine-1-create-ruleset-version" author="forwardmeasure">
        <createTable tableName="ruleset_version">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ruleset" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="ruleset_version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="drl" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="mode" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="max_window_size" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="idle_timeout_seconds" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="VARCHAR(255)"/>
        </createTable>
        <addUniqueConstraint tableName="ruleset_version" columnNames="ruleset,ruleset_version"
            constraintName="uq_ruleset_version_number"/>
        <sql dbms="postgresql">CREATE UNIQUE INDEX uq_ruleset_version_active ON ruleset_version (ruleset) WHERE active = true;</sql>
    </changeSet>
</databaseChangeLog>
