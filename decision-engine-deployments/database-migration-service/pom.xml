<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.decisionengine</groupId>
        <artifactId>decision-engine-deployments</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.decisionengine</groupId>
    <artifactId>decision-engine-database-migration-service</artifactId>
    <packaging>jar</packaging>

    <name>ForwardMeasure Decision Engine :: Database Migration Service</name>
    <description>Bounded Kubernetes migration-job entry point (RulesetMigrationsMain) - a direct port of forwardmeasure-agent-os's own AgentOsMigrationsMain. Reads DECISION_ENGINE_DATABASE_URL/_USERNAME/_PASSWORD (administrator credential here; the SAME env var names mean the runtime credential in the running server - see IMPLEMENTATION-SPEC.md Section 7.3) plus DECISION_ENGINE_RUNTIME_DATABASE_USERNAME/_PASSWORD for the role this job provisions.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>decision-engine-database-migrations</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>decision-engine-database-migration-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.forwardmeasure.decisionengine.migration.service.RulesetMigrationsMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>container-image</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.fabric8</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <configuration>
                            <images>
                                <image>
                                    <name>${container-image.registry}/${container-image.group}/decision-engine-database-migration-service:${container-image.tag}</name>
                                    <build>
                                        <contextDir>${project.basedir}</contextDir>
                                        <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                                    </build>
                                </image>
                            </images>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-container-image</id>
                                <phase>package</phase>
                                <goals><goal>build</goal></goals>
                            </execution>
                            <execution>
                                <id>push-container-image</id>
                                <phase>package</phase>
                                <goals><goal>push</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
